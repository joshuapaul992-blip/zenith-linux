From 4e1ff100871ad958b3e9a12ad2b464878c5b860c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 9 Oct 2026 03:14:26 +0000
Subject: [PATCH 1/4] nouveau: add completion emulation to drm-compat

Provide struct completion with init/reinit_completion, complete,
complete_all, try_wait_for_completion, completion_done,
wait_for_completion[_timeout] and DECLARE_COMPLETION_ONSTACK, plus
msecs_to_jiffies.

Waiters poll in 1ms steps instead of sleeping: get_jiffies() is not
implemented and complete() may run from the interrupt handler or the
work queue process. Linux semantics are kept, complete() releases one
waiter and complete_all() releases all of them until the completion is
re-initialised.

All existing users in DRM core stay behind !defined(__AROS__), so this
only enables code that explicitly asks for it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LaFFmUWBSJL732ja1ybwuh
---
 .../include/drm-compat/drm_compat_funcs.h     | 91 +++++++++++++++++++
 .../include/drm-compat/drm_compat_types.h     |  6 ++
 2 files changed, 97 insertions(+)

diff --git a/workbench/hidds/nouveau/include/drm-compat/drm_compat_funcs.h b/workbench/hidds/nouveau/include/drm-compat/drm_compat_funcs.h
index 55e301f6..bc640423 100644
--- a/workbench/hidds/nouveau/include/drm-compat/drm_compat_funcs.h
+++ b/workbench/hidds/nouveau/include/drm-compat/drm_compat_funcs.h
@@ -436,6 +436,11 @@ unsigned long get_jiffies();
 unsigned int jiffies_to_usecs(const unsigned long j);
 unsigned long usecs_to_jiffies(unsigned int us);
 
+static inline unsigned long msecs_to_jiffies(const unsigned int m)
+{
+    return ((unsigned long)m * HZ + 999) / 1000;
+}
+
 typedef struct {
     struct MinNode wt_Node;
     struct Task *   wt_Task;
@@ -492,6 +497,92 @@ typedef struct {
         __ret;                                                    \
     })
 
+/* Completion (lame) handling
+ *
+ * Waiters poll instead of sleeping: get_jiffies() is not implemented and
+ * complete() can be called from the interrupt handler or the work queue
+ * process. Linux semantics are kept - complete() releases one waiter,
+ * complete_all() releases every waiter until reinit_completion().
+ */
+#define COMPLETION_DONE_ALL             0xffffffffUL
+#define COMPLETION_POLL_USECS           1000
+
+#define DECLARE_COMPLETION_ONSTACK(x)   struct completion x = { .done = 0 }
+
+static inline void init_completion(struct completion *x)
+{
+    x->done = 0;
+}
+
+static inline void reinit_completion(struct completion *x)
+{
+    x->done = 0;
+}
+
+static inline void complete(struct completion *x)
+{
+    Disable();
+    if (x->done != COMPLETION_DONE_ALL)
+        x->done++;
+    Enable();
+}
+
+static inline void complete_all(struct completion *x)
+{
+    x->done = COMPLETION_DONE_ALL;
+}
+
+static inline bool try_wait_for_completion(struct completion *x)
+{
+    bool ret = false;
+
+    Disable();
+    if (x->done)
+    {
+        if (x->done != COMPLETION_DONE_ALL)
+            x->done--;
+        ret = true;
+    }
+    Enable();
+
+    return ret;
+}
+
+static inline bool completion_done(struct completion *x)
+{
+    return x->done != 0;
+}
+
+/* Returns 0 on timeout, otherwise the jiffies left (at least 1) */
+static inline unsigned long wait_for_completion_timeout(struct completion *x, unsigned long timeout)
+{
+    unsigned long usecs = jiffies_to_usecs(timeout);
+
+    for (;;)
+    {
+        unsigned long step;
+
+        if (try_wait_for_completion(x))
+        {
+            unsigned long left = usecs_to_jiffies(usecs);
+            return left ? left : 1;
+        }
+
+        if (usecs == 0)
+            return 0;
+
+        step = usecs < COMPLETION_POLL_USECS ? usecs : COMPLETION_POLL_USECS;
+        udelay(step);
+        usecs -= step;
+    }
+}
+
+static inline void wait_for_completion(struct completion *x)
+{
+    while (!try_wait_for_completion(x))
+        udelay(COMPLETION_POLL_USECS);
+}
+
 /* workqueue handling */
 #define system_unbound_wq NULL
 #define system_long_wq NULL
diff --git a/workbench/hidds/nouveau/include/drm-compat/drm_compat_types.h b/workbench/hidds/nouveau/include/drm-compat/drm_compat_types.h
index 39587bf3..b1217863 100644
--- a/workbench/hidds/nouveau/include/drm-compat/drm_compat_types.h
+++ b/workbench/hidds/nouveau/include/drm-compat/drm_compat_types.h
@@ -165,6 +165,12 @@ ADD2INIT(init_##name, 0)
 /* Wait queue handling */
 typedef struct MinList wait_queue_head_t;
 
+/* Completion emulation */
+struct completion
+{
+    volatile ULONG done;
+};
+
 /* Firmware */
 struct firmware
 {

