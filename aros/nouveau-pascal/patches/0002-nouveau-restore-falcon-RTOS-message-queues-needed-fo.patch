diff --git a/workbench/hidds/nouveau/drm/nouveau/nvkm/falcon/msgqueue.c b/workbench/hidds/nouveau/drm/nouveau/nvkm/falcon/msgqueue.c
index 2ed2b6ad..a901b367 100644
--- a/workbench/hidds/nouveau/drm/nouveau/nvkm/falcon/msgqueue.c
+++ b/workbench/hidds/nouveau/drm/nouveau/nvkm/falcon/msgqueue.c
@@ -252,22 +252,28 @@ cmd_write(struct nvkm_msgqueue *priv, struct nvkm_msgqueue_hdr *cmd,
 {
 	const struct nvkm_subdev *subdev = priv->falcon->owner;
 	static unsigned timeout = 2000;
-NOT_IMPLEMENTED_STOP
-#if 0
+#if !defined(__AROS__)
 	unsigned long end_jiffies = jiffies + msecs_to_jiffies(timeout);
+#else
+	unsigned long usecs = timeout * 1000;
+#endif
 	int ret = -EAGAIN;
 	bool commit = true;
 
+#if !defined(__AROS__)
 	while (ret == -EAGAIN && time_before(jiffies, end_jiffies))
 		ret = cmd_queue_open(priv, queue, cmd->size);
+#else
+	while ((ret = cmd_queue_open(priv, queue, cmd->size)) == -EAGAIN &&
+	       usecs != 0) {
+		usecs -= 1000;
+		udelay(1000);
+	}
+#endif
 	if (ret) {
 		nvkm_error(subdev, "pmu_queue_open_write failed\n");
 		return ret;
 	}
-#else
-	int ret = -EAGAIN;
-	bool commit = true;
-#endif
 
 	ret = cmd_queue_push(priv, queue, cmd, cmd->size);
 	if (ret) {
@@ -331,12 +337,9 @@ nvkm_msgqueue_post(struct nvkm_msgqueue *priv, enum msgqueue_msg_priority prio,
 	struct nvkm_msgqueue_queue *queue;
 	int ret;
 
-NOT_IMPLEMENTED_STOP
-#if 0
 	if (wait_init && !wait_for_completion_timeout(&priv->init_done,
 					 msecs_to_jiffies(1000)))
 		return -ETIMEDOUT;
-#endif
 
 	queue = priv->func->cmd_queue(priv, prio);
 	if (IS_ERR(queue))
@@ -379,11 +382,8 @@ msgqueue_msg_handle(struct nvkm_msgqueue *priv, struct nvkm_msgqueue_hdr *hdr)
 			seq->callback(priv, hdr);
 	}
 
-NOT_IMPLEMENTED_STOP
-#if 0
 	if (seq->completion)
 		complete(seq->completion);
-#endif
 
 	msgqueue_seq_release(priv, seq);
 
@@ -565,10 +565,7 @@ nvkm_msgqueue_reinit(struct nvkm_msgqueue *queue)
 		return 0;
 
 	queue->init_msg_received = false;
-NOT_IMPLEMENTED_STOP
-#if 0
 	reinit_completion(&queue->init_done);
-#endif
 
 	return 0;
 }
@@ -586,10 +583,7 @@ nvkm_msgqueue_ctor(const struct nvkm_msgqueue_func *func,
 	for (i = 0; i < NVKM_MSGQUEUE_NUM_SEQUENCES; i++)
 		queue->seq[i].id = i;
 
-NOT_IMPLEMENTED_STOP
-#if 0
 	init_completion(&queue->init_done);
-#endif
 
 
 }
