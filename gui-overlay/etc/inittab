# Zenith Linux GUI inittab (busybox init).
::sysinit:/etc/zenith/rcS

# Start the X desktop on the first console; respawn it if the session ends.
tty1::respawn:/etc/zenith/xstart

# Rescue/diagnostic shells.
tty2::respawn:-/bin/sh
ttyS0::respawn:-/bin/sh

::ctrlaltdel:/sbin/reboot
::shutdown:/bin/umount -a -r
::restart:/sbin/init
