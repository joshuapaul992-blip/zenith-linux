#!/bin/sh
# Start Ubuntu's Xorg server, then run the genuine DSL 4.4.10 desktop inside a
# chroot of /opt/dsl (its 32-bit clients connect over the shared X socket).
# Respawned by init; on failure, surface logs and drop to a shell.
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
LOG=/var/log/xstart.log
D=/opt/dsl

# X listens on TCP (localhost); the DSL clients run in a chroot and reach it
# via DISPLAY=127.0.0.1:0. A bind-mounted unix socket is NOT connectable from
# inside the chroot (connect() -> ENOENT), so TCP is used instead. Access
# control is off: this is an ephemeral single-user live system.
X :0 vt1 -ac -listen tcp >"$LOG" 2>&1 &
XPID=$!

ok=0
for _ in $(seq 1 40); do [ -S /tmp/.X11-unix/X0 ] && { ok=1; break; }; sleep 0.25; done

rc=1
if [ "$ok" -eq 1 ]; then
  mount --bind /proc "$D/proc" 2>/dev/null
  mount --bind /sys  "$D/sys"  2>/dev/null
  mount --bind /dev  "$D/dev"  2>/dev/null
  chroot "$D" /bin/sh /dsl-session.sh >>"$LOG" 2>&1
  rc=$?
  umount "$D/proc" "$D/sys" "$D/dev" 2>/dev/null
fi

kill "$XPID" 2>/dev/null
[ "$rc" -eq 0 ] && exit 0

{
  echo ""
  echo "=============== Zenith: desktop failed to start (rc=${rc}) ==============="
  echo "DRM cards:";    ls -l /dev/dri/ 2>/dev/null || echo "  (none)"
  echo "Framebuffers:"; ls -l /dev/fb*  2>/dev/null || echo "  (none)"
  echo "---- /var/log/Xorg.0.log (tail) ----"; tail -n 25 /var/log/Xorg.0.log 2>/dev/null
  echo "---- session log (tail) ----";         tail -n 20 "$LOG" 2>/dev/null
  echo "Try the 'safe graphics' or 'pick a screen mode' boot entry."
  echo "Rescue shells are on tty2 / ttyS0."
  echo "========================================================================"
} > /dev/tty1 2>&1
exec /bin/bash </dev/tty1 >/dev/tty1 2>&1
