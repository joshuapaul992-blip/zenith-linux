#!/bin/sh
# Zenith Linux X session: DSL-style desktop (wallpaper + torsmo-ish conky + WM).

xset -b 2>/dev/null                       # silence the bell
xsetroot -solid "#36566f" 2>/dev/null     # DSL-ish steel blue backdrop

# System monitor floating top-right, the way DSL's torsmo did.
conky -d 2>/dev/null &

# Window manager is switchable at runtime via /etc/zenith/setwm.
WM=jwm
[ -r /etc/zenith/wm ] && WM="$(cat /etc/zenith/wm)"
case "$WM" in
  fluxbox) exec fluxbox ;;
  *)       exec jwm ;;
esac
