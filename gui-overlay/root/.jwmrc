<?xml version="1.0"?>
<!-- Zenith Linux JWM config: a nod to the Damn Small Linux 4.4.10 desktop. -->
<JWM>

    <RootMenu height="22" onroot="12">
        <Program label="Terminal" icon="utilities-terminal">xterm</Program>
        <Program label="File Manager">xfe</Program>
        <Separator/>
        <Menu label="Window Manager">
            <Program label="Switch to Fluxbox">/etc/zenith/setwm fluxbox</Program>
            <Program label="Switch to JWM">/etc/zenith/setwm jwm</Program>
        </Menu>
        <Separator/>
        <Restart label="Restart JWM"/>
        <Program label="Reboot">reboot</Program>
        <Program label="Shut Down">poweroff</Program>
    </RootMenu>

    <!-- Bottom panel, DSL-style. -->
    <Tray x="0" y="-1" height="28" autohide="off">
        <TrayButton label="Zenith">root:1</TrayButton>
        <Spacer width="4"/>
        <TaskList maxwidth="220"/>
        <Dock/>
        <Clock format="%a %b %e  %H:%M"><Button mask="123">xterm</Button></Clock>
    </Tray>

    <Group>
        <Option>tiled</Option>
        <Option>aerosnap</Option>
    </Group>

    <!-- Colors / fonts evoking the classic DSL blue-grey theme. -->
    <WindowStyle>
        <Font>Sans-9:bold</Font>
        <Foreground>#ffffff</Foreground>
        <Background>#4a6b84</Background>
        <Active>
            <Foreground>#ffffff</Foreground>
            <Background>#5f86a3</Background>
        </Active>
    </WindowStyle>
    <TrayStyle>
        <Font>Sans-9</Font>
        <Foreground>#ffffff</Foreground>
        <Background>#36566f</Background>
    </TrayStyle>
    <TaskListStyle>
        <Font>Sans-9</Font>
        <Active><Foreground>#ffffff</Foreground><Background>#5f86a3</Background></Active>
        <Foreground>#e8eef3</Foreground>
        <Background>#3f6079</Background>
    </TaskListStyle>
    <MenuStyle>
        <Font>Sans-9</Font>
        <Foreground>#ffffff</Foreground>
        <Background>#3f6079</Background>
        <Active><Foreground>#ffffff</Foreground><Background>#5f86a3</Background></Active>
    </MenuStyle>

    <Desktops width="2" height="1"/>
    <FocusModel>click</FocusModel>
    <DoubleClickTime>400</DoubleClickTime>
    <SnapMode distance="10">border</SnapMode>

    <Key key="Up">up</Key>
    <Key key="Down">down</Key>
    <Key key="Right">right</Key>
    <Key key="Left">left</Key>
    <Key mask="A" key="Tab">nextstacked</Key>
    <Key mask="A" key="F4">close</Key>
    <Key mask="C" key="Return">exec:xterm</Key>

</JWM>
