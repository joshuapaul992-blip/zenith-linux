#!/bin/sh
# Zenith Linux live initramfs PID 1.
# Finds the boot media, mounts the compressed SquashFS root, stacks a tmpfs
# overlay on top (so the system is writable in RAM), and switch_root's in.

BB=/bin/busybox
SQUASH_REL="zenith/rootfs.squashfs"   # path of the squashfs on the boot media

rescue() {
  echo ""
  echo "!! live boot failed: $1"
  echo "!! dropping to an emergency shell."
  exec $BB sh
}

$BB mkdir -p /proc /sys /dev /mnt/media /mnt/sfs /newroot
$BB mount -t proc     proc     /proc
$BB mount -t sysfs    sysfs    /sys
$BB mount -t devtmpfs devtmpfs /dev 2>/dev/null || $BB mdev -s
$BB dmesg -n 1 2>/dev/null || true

# Give USB/SATA a moment to enumerate, then populate /dev nodes.
$BB mdev -s 2>/dev/null || true
tries=0
while [ "$tries" -lt 20 ]; do
  $BB mdev -s 2>/dev/null || true
  # Probe every block device for the squashfs.
  for dev in $($BB ls /sys/class/block 2>/dev/null); do
    case "$dev" in loop*|ram*) continue ;; esac
    node="/dev/$dev"
    [ -b "$node" ] || continue
    if $BB mount -o ro "$node" /mnt/media 2>/dev/null; then
      if [ -f "/mnt/media/${SQUASH_REL}" ]; then
        echo "== found root on ${node}"
        FOUND="$node"
        break 2
      fi
      $BB umount /mnt/media 2>/dev/null
    fi
  done
  tries=$((tries + 1))
  $BB sleep 1
done

[ -n "$FOUND" ] || rescue "could not find ${SQUASH_REL} on any block device"

# Mount the squashfs (loopback), then an overlay: ro squashfs + tmpfs rw.
$BB mount -t squashfs -o ro,loop "/mnt/media/${SQUASH_REL}" /mnt/sfs \
  || rescue "could not mount squashfs"

$BB mkdir -p /mnt/rw
$BB mount -t tmpfs tmpfs /mnt/rw || rescue "could not create tmpfs"
$BB mkdir -p /mnt/rw/upper /mnt/rw/work
$BB mount -t overlay overlay \
  -o lowerdir=/mnt/sfs,upperdir=/mnt/rw/upper,workdir=/mnt/rw/work /newroot \
  || rescue "could not create overlay"

# Carry the kernel-managed filesystems and the backing mounts into the new root
# so the loop-mounted squashfs stays valid after switch_root.
$BB mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/mnt/.media /newroot/mnt/.sfs
$BB mount --move /proc      /newroot/proc
$BB mount --move /sys       /newroot/sys
$BB mount --move /dev       /newroot/dev
$BB mount --move /mnt/media /newroot/mnt/.media
$BB mount --move /mnt/sfs   /newroot/mnt/.sfs

[ -x /newroot/sbin/init ] || rescue "no /sbin/init in root filesystem"
exec $BB switch_root /newroot /sbin/init
